# Скопируй этот файл в .env и вставь свои ключи
# PORT можно не трогать, по умолчанию 3001
PORT=3001

# Rule34.xxx — получи на https://rule34.xxx/index.php?page=account&s=api (нужна регистрация)
# После входа: User ID и API Key покажет в профиле
RULE34_API_KEY=
RULE34_USER_ID=

# Gelbooru — https://gelbooru.com/index.php?page=account&s=options -> API Access
GELBOORU_API_KEY=
GELBOORU_USER_ID=

# Danbooru работает без ключа для SFW, для NSFW нужен Gold аккаунт, но можно оставить пустым
# DANBOORU_LOGIN=
# DANBOORU_API_KEY=
